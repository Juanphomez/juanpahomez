# Canonical origin. Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://juanpablohomez.com

# --- Analytics (optional) -------------------------------------------------
# Set either one. GTM is preferred: the event contract in lib/analytics.ts
# pushes to window.dataLayer, which GTM reads directly.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# --- Contact form delivery -----------------------------------------------
# Option A — forward submissions as JSON to an automation (Zapier, Make, n8n).
CONTACT_WEBHOOK_URL=

# Option B — send the email through Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
